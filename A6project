
import java.util.Scanner;

public class InputOutputUnit {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int data;

        // Input Instruction
        System.out.print("Enter data: ");
        data = sc.nextInt();

        // Output Instruction
        System.out.println("Output data: " + data);

        sc.close();
    }
}
